# Grundsaetzlich alles aus bin und obj ignorieren
bin/
obj/

# Damit Unterordner nicht komplett blockiert werden:
!bin/**/
!obj/**/

# Ausnahmen: nur exe- und pdb-Dateien zulassen
!bin/**/*.exe
!bin/**/*.pdb
!obj/**/*.exe
!obj/**/*.pdb

# Sicherheitsnetz: jede andere Datei in bin/ oder obj/ trotzdem ignorieren
bin/**/*.* !bin/**/*.exe !bin/**/*.pdb
obj/**/*.* !obj/**/*.exe !obj/**/*.pdb

# Mac
.DS_Store